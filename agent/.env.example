# Application Configuration
APP_NAME=Social Media Management Agent
APP_VERSION=1.0.0
DEBUG=False
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=your-secret-key-here-change-this-to-something-random-and-secure
TOKEN_ENCRYPTION_KEY=your-32-byte-fernet-key-here-for-social-tokens
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/smm_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM Configuration
# Options: openai, anthropic, gemini
LLM_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=AIzaSyB4zthtf6hUL16sPW44TsAYHs8vUKwpnaI
# Model options: gpt-4o, claude-3-5-sonnet-20241022, gemini-1.5-pro, gemini-1.5-flash
DEFAULT_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Instagram API
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Facebook API
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Twitter API
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# TikTok API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# YouTube API
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# LinkedIn API
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
